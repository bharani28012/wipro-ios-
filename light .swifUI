import SwiftUI
struct ContentView:View{
    @State var ShowMessage = false
    @State var ShowMessage1 = false
    var body:some View {
        VStack{
            Text("Room light")
            Text("  💡")
            HStack{
                VStack{
                    Button("off"){
                        ShowMessage=true
                        ShowMessage1= false

                    }
                    .frame(width:50,height:40)
                    .background(Color.black)
                    .foregroundColor(.blue)
                    .cornerRadius(20)
                    if ShowMessage{
                        Text("light status : OFF")
                    }
                }
                VStack{
                        Button("ON"){
                            ShowMessage1 = true
                            ShowMessage=false
                        }
                        .frame(width:50,height:40)
                        .background(Color.black)
                        .foregroundColor(.blue)
                        .cornerRadius(20)
                         if ShowMessage1{
                            Text("light status : ON")
                        }
                }


            }

        }

    }
}