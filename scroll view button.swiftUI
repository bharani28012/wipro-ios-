import SwiftUI

struct ContentView: View {
    var body: some View {
        ScrollView {
            VStack {
                Text("Apple")
                Text("Orange")
                Text("Mango")
                Text("Banana")
                Text("Grapes")
                Text("Pineapple")
                Text("Watermelon")
               //in an scroll view we used to scroll the text like an phone
            }
        }
    }
}